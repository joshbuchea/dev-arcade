<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }} - Dev Arcade</title>
    <meta name="description" content="{{ description }}" />

    <!-- Google Fonts -->
    <link
      href="https://fonts.googleapis.com/css?family=Press+Start+2P"
      rel="stylesheet"
    />

    <style>
      :root {
        --color-text: #000;
        --color-background: #fff;
        --color-primary: hsl(240, 100%, 57%);
        --color-gray: #555;
      }

      [data-theme="black"] {
        --color-text: #fff;
        --color-background: #000;
        --color-primary: #0ff;
        --color-gray: #888;
      }

      [data-theme="dark"] {
        --color-text: #fff;
        --color-background: hsl(180, 5%, 15%);
        --color-primary: hsl(180, 100%, 57%);
        --color-gray: hsl(180, 0%, 70%);
      }

      [data-theme="deep"] {
        --color-text: #fff;
        --color-background: hsl(230, 25%, 18%);
        --color-primary: hsl(260, 100%, 80%);
        --color-gray: hsl(210, 50%, 60%);
      }

      [data-theme="hack"] {
        --color-text: hsl(120, 100%, 75%);
        --color-background: hsl(120, 20%, 10%);
        --color-primary: hsl(120, 100%, 40%);
        --color-gray: hsl(120, 20%, 40%);
      }

      [data-theme="pink"] {
        --color-text: hsl(350, 80%, 10%);
        --color-background: hsl(350, 100%, 90%);
        --color-primary: hsl(350, 100%, 50%);
        --color-gray: hsl(350, 40%, 50%);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Press Start 2P", cursive;
        line-height: 1.625;
        font-size: 16px;
        color: var(--color-text);
        background-color: var(--color-background);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        transition: background-color 0.3s ease, color 0.3s ease;
      }

      header {
        width: 100%;
        display: flex;
        align-items: center;
        max-width: 1280px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }

      header a {
        color: inherit;
        text-decoration: none;
        margin-right: 1.5rem;
      }

      header a:hover {
        color: var(--color-primary);
      }

      .color-mode-button {
        display: inline-block;
        appearance: none;
        background: transparent;
        color: inherit;
        padding: 0.5rem;
        margin: 0;
        border: 0;
        border-radius: 9999px;
        cursor: pointer;
        margin-left: auto;
      }

      .color-mode-button:hover,
      .color-mode-button:focus {
        color: var(--color-primary);
        box-shadow: 0 0 0 3px var(--color-primary);
        outline: none;
      }

      .color-mode-button svg {
        display: block;
      }

      main {
        width: 100%;
        max-width: 1280px;
        padding: 0 1.5rem;
        margin: 0 auto;
        flex: 1 1 auto;
      }

      .banner {
        padding: 4rem 0 6rem;
        font-weight: bold;
        text-align: center;
      }

      .banner h1 {
        font-size: 48px;
        margin: 0 0 1rem;
        line-height: 1.25;
      }

      .banner p {
        font-size: 20px;
        margin: 0;
      }

      .games {
        display: grid;
        grid-gap: 24px;
        grid-template-columns: repeat(auto-fill, minmax(296px, 1fr));
        margin: auto;
        max-width: 1280px;
        padding: 4rem 0;
        text-align: center;
      }

      .game {
        display: block;
        margin-bottom: 24px;
        text-decoration: none;
        color: inherit;
        width: 100%;
      }

      .game:hover {
        color: var(--color-primary);
      }

      .game-image {
        border: 2px solid var(--color-gray);
        height: auto;
        margin-bottom: 0.5rem;
        width: 100%;
        display: block;
      }

      footer {
        padding: 3rem 1.5rem;
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
      }

      footer .footer-content {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        font-size: 14px;
      }

      footer a {
        color: inherit;
        text-decoration: none;
      }

      footer a:hover {
        color: var(--color-primary);
      }

      .footer-left {
        margin: 1rem 0;
      }

      .footer-spacer {
        flex: 1 1 auto;
      }

      .footer-right {
        margin: 1rem 0;
      }

      @media (min-width: 640px) {
        .banner h1 {
          font-size: 64px;
        }
      }

      @media (min-width: 832px) {
        .banner h1 {
          font-size: 72px;
        }
      }

      @media (min-width: 1024px) {
        .banner h1 {
          font-size: 96px;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/">Dev Arcade</a>
      <button aria-label="Cycle Color Mode" class="color-mode-button" title="Cycle Color Mode">
        <svg fill="currentcolor" height="24" viewBox="0 0 32 32" width="24">
          <circle cx="16" cy="16" fill="none" r="14" stroke="currentcolor" stroke-width="4"></circle>
          <path d="M 16 0 A 16 16 0 0 0 16 32 z"></path>
        </svg>
      </button>
    </header>

    <main>
      {{ content | safe }}
    </main>

    <footer>
      <div class="footer-content">
        <div class="footer-left">
          <a
            href="https://github.com/joshbuchea/dev-arcade/"
            target="_blank"
            title="View Source"
          >
            View Source
          </a>
        </div>
        <div class="footer-spacer"></div>
        <div class="footer-right">
          Made by
          <a
            href="https://joshbuchea.com/"
            target="_blank"
            >Josh Buchea</a
          >
        </div>
      </div>
    </footer>

    <script>
      // Theme switcher
      const modes = ['light', 'black', 'dark', 'deep', 'hack', 'pink'];
      const body = document.body;
      const colorModeButton = document.querySelector('.color-mode-button');

      // Get initial theme from localStorage or default to 'light'
      let currentMode = localStorage.getItem('color-mode') || 'light';
      
      // Apply initial theme
      function applyTheme(mode) {
        if (mode === 'light') {
          body.removeAttribute('data-theme');
        } else {
          body.setAttribute('data-theme', mode);
        }
      }
      
      applyTheme(currentMode);

      // Cycle through themes on button click
      colorModeButton.addEventListener('click', () => {
        const currentIndex = modes.indexOf(currentMode);
        const nextIndex = (currentIndex + 1) % modes.length;
        currentMode = modes[nextIndex];
        
        applyTheme(currentMode);
        localStorage.setItem('color-mode', currentMode);
      });
    </script>
  </body>
</html>
